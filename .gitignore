# Public project page only. Raw data, archives, paper drafts, local planning,
# media-processing scripts, debug output and unused assets stay on this machine.
/*
!/.gitignore
!/index.html
!/assets/

/assets/*
!/assets/css/
!/assets/js/
!/assets/data/
!/assets/images/
!/assets/videos/

/assets/css/*
!/assets/css/style.css
/assets/js/*
!/assets/js/main.js
/assets/data/*
!/assets/data/results.json

# Images referenced by the current page.
/assets/images/*
!/assets/images/ila-logo.png
!/assets/images/teaser.png
!/assets/images/pipeline.png
!/assets/images/overview.jpg
!/assets/images/preview-cucumber.jpg
!/assets/images/preview-egg.jpg
!/assets/images/preview-celery.jpg
!/assets/images/preview-plate.jpg

# Full demonstration and the four interaction highlights only.
/assets/videos/*
!/assets/videos/overview.mp4
!/assets/videos/preview-cucumber.mp4
!/assets/videos/preview-egg.mp4
!/assets/videos/preview-celery.mp4
!/assets/videos/preview-plate.mp4

# Add explicit exceptions above when publishing additional assets.
